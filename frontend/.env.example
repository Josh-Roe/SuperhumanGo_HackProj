# Development server only. Never place API credentials in VITE_* variables.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Public browser settings only. Obtain Member 2's schema acceptance before enabling.
# Never place service-role keys, MCP connector tokens, or provider secrets here.
VITE_EVENT_API_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public, hosted HTTPS MCP URL shown in Go setup. No tokens/query secrets.
VITE_PUBLIC_MCP_URL=

# Vercel server function only. Hosted Python backend origin, HTTPS, no path/token.
# Does not use the VITE_ prefix. Vercel project Root Directory must be frontend.
BACKEND_ORIGIN=
