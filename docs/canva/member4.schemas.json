  "GoContent": {
    "additionalProperties": false,
    "description": "Load from Member 3's trusted content repository, never raw browser claims.",
    "properties": {
      "event_id": {
        "pattern": "^[A-Za-z0-9_-]{1,128}$",
        "title": "Event Id",
        "type": "string"
      },
