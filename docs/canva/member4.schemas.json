        "minimum": 1,
        "title": "Event Revision",
        "type": "integer"
      },
      "producer": {
        "const": "superhuman_go",
        "title": "Producer",
        "type": "string"
      },
      "generation_id": {
        "pattern": "^[A-Za-z0-9_-]{1,128}$",
        "title": "Generation Id",
        "type": "string"
      },
      "kind": {
        "enum": [
          "flyer_brief",
          "flyer_copy",
          "event_document",
          "plain_language_summary",
          "flyer_alt_text"
        ],
        "title": "Kind",
        "type": "string"
      },
      "body": {
        "maxLength": 30000,
        "minLength": 1,
        "title": "Body",
        "type": "string"
      },
      "language": {
        "default": "en",
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
