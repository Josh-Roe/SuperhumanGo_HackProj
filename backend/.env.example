# Local Python backend only. Root .env is used separately by Docker Compose.
# Generate a private token: python -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_AUTH_TOKEN=
# Bare public hostname, or localhost for local development.
APP_DOMAIN=localhost
# Organizer dashboard origin. Go's event tools return <APP_URL>/?event=<id> links.
APP_URL=https://mtcxhackathon1.vercel.app
# Optional existing model. Install uv sync --extra dev --extra ml to enable CPU inference.
ONNX_MODEL_PATH=
# Supabase project connection. Keep service-role credentials server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Fernet key. Generate on the server: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Isolated mock/demo only. Keep disabled on deployed multiuser environments.
WORKFLOW_DEV_MODE=0
DEV_CONNECTOR_TOKEN=
DEV_INVITEES=
DEV_ORGANIZER_CONTACT=
