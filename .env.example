# Local Docker: HTTP only. VPS: set both values to your public DNS hostname.
APP_DOMAIN=localhost
SITE_ADDRESS=http://localhost

# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Required for Compose and for MCP access. Never put this value in frontend code.
MCP_AUTH_TOKEN=

# Optional: enable INSTALL_ML and place your model under models/.
INSTALL_ML=false
ONNX_MODEL_PATH=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIAL_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
